## 梯度下降：沿着损失地形寻找最优参数

{@body const [learningRate,setLearningRate] = DIL.useState(0.1)}
{@body const [step,setStep] = DIL.useState(0)}
{@body const [selected,setSelected] = DIL.useState("particle")}
{@body const data = [[0,1],[1,3],[2,5]]}
{@body const loss = (w,b)=>data.reduce((s,[x,y])=>s+(w*x+b-y)**2,0)/(2*data.length)}
{@body const history = Array.from({length:41}).reduce((a,_,i)=>{if(!i)return [{w:0,b:0,loss:loss(0,0),gw:0,gb:0}];const p=a[i-1];const gw=data.reduce((s,[x,y])=>s+(p.w*x+p.b-y)*x,0)/3;const gb=data.reduce((s,[x,y])=>s+(p.w*x+p.b-y),0)/3;const w=p.w-learningRate*gw,b=p.b-learningRate*gb;return [...a,{w,b,loss:loss(w,b),gw,gb}]},[])}
{@body const current = history[Math.min(step,40)]}
{@body const vertices = Array.from({length:169},(_,i)=>{const w=(i%13)/3,b=Math.floor(i/13)/3;return [w,loss(w,b)*0.15,b]})}
{@body const indices = Array.from({length:144},(_,i)=>{const q=Math.floor(i/12)*13+i%12;return [q,q+13,q+1,q+1,q+13,q+14]}).flat()}
{@body const objects = [{id:"terrain",type:"mesh",vertices,indices,color:"#8098b0",opacity:0.7},{id:"path",type:"line",points:history.slice(0,step+1).map(p=>[p.w,p.loss*.15+.08,p.b]),color:"#526b88",width:3},{id:"particle",type:"sphere",position:[current.w,current.loss*.15+.08,current.b],size:[.13,.13,.13],color:"#cc9553",label:"参数 w="+current.w.toFixed(3)+", b="+current.b.toFixed(3)}]}
<box>
<text>目标函数使用均方误差的一半。每次按同一组旧参数计算两个梯度，再同时更新 w 和 b。三维坐标为 w、0.15×损失、b。</text>
<formula content={String.raw`J(w,b)=\frac{1}{2n}\sum_i(wx_i+b-y_i)^2,\quad \theta_{t+1}=\theta_t-\eta\nabla J`}/>
<slider label="学习率 η" min={0.01} max={0.8} step={0.01} value={learningRate} onChange={v=>{setLearningRate(v);setStep(0)}}/>
<stepper value={step} onChange={setStep} max={40} label="训练步骤"/>
<scene objects={objects} camera={[6,5,7]} selected={selected} onSelect={setSelected} caption="旋转地形观察参数轨迹；橙色粒子是当前参数。点击粒子查看数值。"/>
<row><metric label="损失 J" value={current.loss.toFixed(6)}/><metric label="斜率 w" value={current.w.toFixed(6)}/><metric label="截距 b" value={current.b.toFixed(6)}/></row>
<table columns={["本次更新使用的梯度","数值"]} rows={[["∂J/∂w",current.gw.toFixed(6)],["∂J/∂b",current.gb.toFixed(6)]]}/>
<chart data={history.slice(0,step+1).map((p,x)=>({x,loss:p.loss}))} xKey="x" yKey="loss" label="损失随步骤变化"/>
<code>const residual = w * x + b - y; const gw = mean(residual * x); const gb = mean(residual); [w, b] = [w - eta * gw, b - eta * gb];</code>
</box>
